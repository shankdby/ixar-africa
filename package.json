{
  "name": "ixar-africa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run images && npm run build:client && npm run build:ssr && npm run prerender",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.jsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "build:standalone": "vite build --config vite.config.standalone.js && node scripts/inline-standalone.mjs",
    "images": "node scripts/gen-image-manifest.mjs"
  },
  "dependencies": {
    "framer-motion": "^13.1.1",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "image-size": "^2.0.2",
    "vite": "^5.1.4"
  }
}
